import java.util.ArrayList;
import java.util.List;

public class Main {
    public static void main(String[] args) {
        List<ContaBancaria> contas = new ArrayList<>();

        contas.add(new ContaCorrente("1234-5", "Ana Souza"));
        contas.add(new ContaPoupanca("6789-0", "Bruno Silva"));
        contas.add(new ContaSalario("1111-2", "Carla Oliveira"));

        // Demonstração do Polimorfismo e chamadas
        for (ContaBancaria conta : contas) {
            System.out.println("Titular: " + conta.getTitular() + " | Tipo: " + conta.getClass().getSimpleName());
            System.out.printf("Rendimento calculado: R$ %.2f%n", conta.calcularRendimento());
            
            if (conta instanceof Tributavel) {
                Tributavel tributavel = (Tributavel) conta;
                System.out.printf("Imposto calculado: R$ %.2f%n", tributavel.calcularImposto());
            } else {
                System.out.println("Imposto: Isento");
            }
            System.out.println("--------------------------------------------------");
        }

        // Demonstração de Operação Inválida (Conta Bloqueada)
        try {
            ContaBancaria contaTeste = contas.get(0);
            contaTeste.bloquear();
            contaTeste.sacar(100.0);
        } catch (OperacaoInvalidaException e) {
            System.out.println("Exceção capturada com sucesso: " + e.getMessage());
        }
    }
